# Copie para .env e preencha. Nunca compartilhe nem tire print deste arquivo com a chave.
JEV_API_KEY=
# Opcionais (só se usar outro provedor do JEV):
# JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=jev-latest
#
# Para usar o Clef da Cloudflare (Workers AI, 10.000 neurons grátis por dia, sem cartão).
# A JEV_API_KEY passa a ser o token da API da Cloudflare (permissão "Workers AI").
# Troque SEU_ACCOUNT_ID pelo Account ID da sua conta Cloudflare:
# JEV_BASE_URL=https://api.cloudflare.com/client/v4/accounts/SEU_ACCOUNT_ID/ai/run/@cf/cloudflare/clef-flash
# JEV_MODEL=clef-flash
#
# Para usar o JEV pelo Vercel AI Gateway (a JEV_API_KEY passa a ser a chave vck_ da Vercel):
# JEV_BASE_URL=https://ai-gateway.vercel.sh/typesafe/v1/systemone
# JEV_MODEL=typesafe-ai/jev
#
# Para usar o JEV pelo OpenRouter (a JEV_API_KEY passa a ser a chave do OpenRouter):
# JEV_BASE_URL=https://openrouter.ai/api/alpha/decisions
# JEV_MODEL=typesafe/jev-1.13
